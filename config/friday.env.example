# FRIDAY tunables. Copy to config/friday.env and uncomment what you need.
# Sourced by bin/friday. Every value is optional - defaults are in
# src/friday/config.py. This file must contain NO secrets.
#
# Secrets belong in config/secrets.env (mode 600), which is gitignored.

# ---- backend -------------------------------------------------------------
# auto = local Nemotron if reachable, else Claude API if a key is present
# FRIDAY_BACKEND=auto
# FRIDAY_LLAMA_CTX=4096

# ---- session -------------------------------------------------------------
# FRIDAY_SESSION_WINDOW=30
# FRIDAY_WAKE_ACK="Yeah?"

# ---- microphone gating ---------------------------------------------------
# Raise these in a noisy room; lower them if quiet speech is being dropped.
# FRIDAY_SPEECH_MIN_PEAK=2500
# FRIDAY_SPEECH_RMS_MULT=1.6
# FRIDAY_TTS_SETTLE=0.6

# ---- command execution ---------------------------------------------------
# Leave both at 0. Setting ALLOW_DESTRUCTIVE=1 permits irreversible commands
# after spoken confirmation; there is no reason to enable it casually.
# FRIDAY_EXEC_TIMEOUT=30
# FRIDAY_ALLOW_DESTRUCTIVE=0
# FRIDAY_AUTO_LOW_RISK=0

# ---- optional wake-word engine ------------------------------------------
# Default is whisper matching on the word "Friday" (85% when combined with a
# request, no extra CPU). The openWakeWord engine costs ~20% of one core
# continuously and has no pretrained "friday" model - see README.
# FRIDAY_WAKE_ENGINE=whisper
# FRIDAY_WAKE_MODEL=hey_jarvis
# FRIDAY_WAKE_THRESHOLD=0.5
